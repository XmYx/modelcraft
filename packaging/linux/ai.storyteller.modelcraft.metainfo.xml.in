<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>ai.storyteller.modelcraft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>ModelCraft</name>
  <summary>3D modeling and sculpting</summary>
  <description>
    <p>ModelCraft is an open-source 3D modeling and sculpting app, one of the Crafting Apps.</p>
    <p>Build shapes from parametric primitives with an editable build history, smooth cages and
    deformers, then sculpt high-resolution meshes with symmetric brushes and masks. Projects save
    atomically with a crash journal; glTF/GLB and OBJ move models to and from the other Crafting Apps.</p>
  </description>
  <launchable type="desktop-id">ai.storyteller.modelcraft.desktop</launchable>
  <url type="homepage">https://github.com/storytold/modelcraft</url>
  <developer id="ai.storyteller">
    <name>ArtCraft Team</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
