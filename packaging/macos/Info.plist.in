<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>ModelCraft</string>
  <key>CFBundleName</key>
  <string>ModelCraft</string>
  <key>CFBundleExecutable</key>
  <string>ModelCraft</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.modelcraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>ModelCraftVersion</key>
  <string>@VERSION@</string>
  <key>ModelCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>ModelCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the ModelCraft authors. MIT OR Apache-2.0.</string>

  <!-- The documents ModelCraft opens, so Finder's Open With can offer it. Other apps stay the
       preferred handler for the exchange formats unless the user picks ModelCraft. The same set
       as the Windows installer (modelcraft.wxs) and the Linux desktop file. Finder's open-document
       Apple events are not handled yet (docs/gaps.md); files passed on the command line open. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>ModelCraft Scene</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>CFBundleTypeIconFile</key>
      <string>ModelCraft</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>ai.storyteller.modelcraft.scene</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>glTF Binary</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array><string>glb</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>model/gltf-binary</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>glTF</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array><string>gltf</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>model/gltf+json</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Wavefront OBJ</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array><string>obj</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>model/obj</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>STL</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array><string>stl</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>model/stl</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PLY</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>CFBundleTypeExtensions</key>
      <array><string>ply</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>model/x-ply</string></array>
    </dict>
  </array>

  <!-- ModelCraft's own format: a zip of a JSON scene plus binary mesh blobs. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.modelcraft.scene</string>
      <key>UTTypeDescription</key>
      <string>ModelCraft Scene</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.3d-content</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>ModelCraft</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>modelcraft</string></array>
        <key>public.mime-type</key>
        <array><string>application/vnd.storytold.modelcraft+zip</string></array>
      </dict>
    </dict>
  </array>

</dict>
</plist>
